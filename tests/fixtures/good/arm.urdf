<?xml version="1.0"?>
<robot name="arm">
  <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
  <link name="base">
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="4.0"/>
      <inertia ixx="0.0233" ixy="0" ixz="0" iyy="0.0233" iyz="0" izz="0.0200"/>
    </inertial>
    <visual><geometry><cylinder radius="0.1" length="0.1"/></geometry><material name="grey"/></visual>
    <collision><geometry><cylinder radius="0.1" length="0.1"/></geometry></collision>
  </link>
  <link name="upper">
    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="1.5"/>
      <inertia ixx="0.0127" ixy="0" ixz="0" iyy="0.0127" iyz="0" izz="0.0008"/>
    </inertial>
    <visual><geometry><box size="0.05 0.05 0.3"/></geometry><material name="grey"/></visual>
  </link>
  <link name="fore">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.0042" ixy="0" ixz="0" iyy="0.0042" iyz="0" izz="0.0003"/>
    </inertial>
    <collision><geometry><box size="0.04 0.04 0.25"/></geometry></collision>
  </link>
  <link name="tool"/>
  <joint name="shoulder" type="revolute">
    <parent link="base"/><child link="upper"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="30" velocity="2.0"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper"/><child link="fore"/>
    <origin xyz="0 0 0.3"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.4" effort="20" velocity="2.5"/>
  </joint>
  <joint name="tool_mount" type="fixed">
    <parent link="fore"/><child link="tool"/>
    <origin xyz="0 0 0.25"/>
  </joint>
</robot>
